			13 00 02 AF 26
			13 00 02 B0 2B
			13 00 02 B1 54
			13 00 02 B2 5E
			13 00 02 B3 23

			//Neg Regis
			13 00 02 C0 00
			13 00 02 C1 21
			13 00 02 C2 35
			13 00 02 C3 19
			13 00 02 C4 1E
			13 00 02 C5 33
			13 00 02 C6 27
			13 00 02 C7 26
			13 00 02 C8 AF
			13 00 02 C9 1B
			13 00 02 CA 27
			13 00 02 CB 8D
			13 00 02 CC 1A
			13 00 02 CD 1B
			13 00 02 CE 50
			13 00 02 CF 26
			13 00 02 D0 2B
			13 00 02 D1 54
			13 00 02 D2 5E
			13 00 02 D3 23

			//========= Gamma END===========
			//CMD_Page 		
			29 00 04 FF 98 81 00
			
			05 78 01 11
			05 1E 01 29
		];
		
		panel-exit-sequence = [
			05 00 01 28
			05 00 01 10
		];

		disp_timings0: display-timings {
			native-mode = <&dsi0_timing0>;
			dsi0_timing0: timing0 {
				clock-frequency = <70000000>;
				hactive = <800>;
				vactive = <1280>;
				hfront-porch = <20>;
				hsync-len = <20>;
				hback-porch = <40>;
				vfront-porch = <20>;
				vsync-len = <4>;
				vback-porch = <20>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
			/*dsi0_timing0: timing0 {//liushuming add
				clock-frequency = <148500000>;
				hactive = <1920>;
				vactive = <1080>;
				hfront-porch = <140>;
				hsync-len = <40>;
				hback-porch = <100>;
				vfront-porch = <15>;
				vsync-len = <20>;
				vback-porch = <10>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};*/
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				panel_in_dsi: endpoint {
					remote-endpoint = <&dsi_out_panel>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			dsi_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi>;
			};
		};
	};

};

&dsi0_in_vp2 {
	status = "disabled";
};

&dsi0_in_vp3 {
	status = "okay";
};


&route_dsi0 {
	status = "okay";
	connect = <&vp3_out_dsi0>;
};

&gpu {
	mali-supply = <&vdd_gpu_s0>;
	mem-supply = <&vdd_gpu_mem_s0>;
	status = "okay";
};

&gpu_mali {
	mali-supply = <&vdd_gpu_s0>;
	mem-supply = <&vdd_gpu_mem_s0>;
	status = "okay";
};

&iep {
	status = "okay";

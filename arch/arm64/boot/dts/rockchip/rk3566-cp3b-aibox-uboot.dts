&u2phy0_otg {
	vbus-supply = <&vcc5v0_otg>;
	status = "okay";
};

&usb2phy0 {
	status = "okay";
};

&usbdrd_dwc3 {
	dr_mode = "host";
	status = "okay";
};

&usbdrd30 {
	status = "okay";
};

//host1
&u2phy0_host {
	phy-supply = <&vcc5v0_host>;
	status = "disabled";
};

&usbhost_dwc3 {
	phys = <&u2phy0_host>;
	phy-names = "usb2-phy";
	maximum-speed = "high-speed";
	snps,dis_u2_susphy_quirk;
	status = "disabled";
};

&usbhost30 {
	status = "disabled";
};

//host2
&u2phy1_otg {
	phy-supply = <&vcc5v0_host>;
	status = "disabled";
};


&pinctrl {
	usb-typec {
		typec5v_pwren: typec5v-pwren {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	tp9950 {
		tp9950_pwren: tp9950-pwren {
			rockchip,pins = <4 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
		tp9950_reset1: tp9950-reset1 {
			rockchip,pins = <4 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>;

		};
		tp9950_reset2: tp9950-reset2 {
			rockchip,pins = <4 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>;

		};
		tp9950_reset3: tp9950-reset3 {
			rockchip,pins = <4 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>;

		};
		tp9950_reset4: tp9950-reset4 {
			rockchip,pins = <4 RK_PB1 RK_FUNC_GPIO &pcfg_pull_up>;

		};
		tp9950_reset5: tp9950-reset5 {
			rockchip,pins = <4 RK_PB7 RK_FUNC_GPIO &pcfg_pull_up>;

		};
	};
	
	i2c_io {
		i2c_gpio_pins: i2c-gpio-pins{
			rockchip,pins = <1 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>,
			<1 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};